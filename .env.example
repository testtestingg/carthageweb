# Admin panel bootstrap credentials.
# Used only on first run to create data/admin-user.json (password is stored
# as a scrypt hash, never in plain text). Change the password from
# /admin/settings after the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please-1

# Secret used to sign admin session cookies (min 32 chars).
# If unset, a random secret is generated and persisted in data/.auth-secret.
# Set it explicitly when running multiple instances behind a load balancer.
AUTH_SECRET=

# Absolute site URL used in sitemap.xml
NEXT_PUBLIC_SITE_URL=https://carthagecare.de
