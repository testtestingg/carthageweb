# ---------- Supabase (recommended backend) ----------
# Create a project at https://supabase.com, run supabase/schema.sql in the
# SQL editor once, then paste the two values below (Settings > API).
# As soon as both are set, products, categories, formations, contact
# messages, the admin account and image uploads all live in Supabase.
# Leave them empty to fall back to the local JSON store in data/.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
         
# ---------- Resend (academy enrollment emails) ----------
# API key from https://resend.com/api-keys. Without it, enrollment still
# works (entries appear in the admin dashboard) but no emails are sent.
RESEND_API_KEY=
# Verified sender, e.g. "Carthage Academy <academy@carthage.de>"
RESEND_FROM_EMAIL=
# Where new-enrollment notifications are sent (you, the site owner)
OWNER_NOTIFICATION_EMAIL=

# Admin panel bootstrap credentials.
# Used only on first login to create the admin account (password is stored
# as a scrypt hash, never in plain text). Change the password from
# /admin/settings after the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please-1

# Secret used to sign admin session cookies (min 32 chars).
# Optional: when Supabase is configured a stable secret is derived
# automatically; without Supabase a random one is persisted in
# data/.auth-secret. Set it explicitly when running multiple instances.
AUTH_SECRET=

# Absolute site URL used in sitemap.xml
NEXT_PUBLIC_SITE_URL=https://carthage.de
